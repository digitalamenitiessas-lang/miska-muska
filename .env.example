# ---------------------------------------------------------------------------
# Copiá este archivo a .env y completá lo que uses.
# Nada de esto se commitea: .env está en .gitignore.
#
# En producción NO uses un archivo .env: cargá estas variables como secretos de
# la plataforma (fly secrets set / variables de Railway / etc).
# ---------------------------------------------------------------------------

# --- Base de datos (Supabase) -----------------------------------------------
# Supabase → Project Settings → Database → Connection string.
#
# Usá la del POOLER en modo "Session" (host aws-*.pooler.supabase.com, puerto
# 5432). Las otras dos opciones dan problemas:
#   · "Transaction" (puerto 6543) es para serverless y no soporta prepared
#     statements, que es lo que usa un proceso largo como este.
#   · La conexión directa (db.*.supabase.co) es solo IPv6 en los proyectos
#     nuevos, y la mayoría de las plataformas de contenedores dan IPv4.
DATABASE_URL=postgresql://postgres.TU-PROYECTO@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# La contraseña VA ACÁ, fuera de la URL, y se escribe tal cual, sin escapar nada.
#
# Ponerla dentro de DATABASE_URL funciona solo si no tiene caracteres especiales.
# Las que genera Supabase suelen tener `%`, y dentro de una URL eso se lee como
# el comienzo de un escape:
#   ...B%CFjn...  -> el proceso crashea con `URIError: URI malformed`, sin
#                    ninguna mención a contraseñas en el error
#   ...ab%41cd... -> se decodifica en silencio a `abAcd` y falla la autenticación
# Definiendo esta variable, la contraseña que traiga la URL se ignora.
DATABASE_PASSWORD=

# Cantidad máxima de conexiones del pool. Con una sola instancia, 5 sobra.
DATABASE_POOL_MAX=5

# Poné DATABASE_SSL=0 SOLO para el Postgres local de desarrollo:
#   docker run -d --name miska-pg -e POSTGRES_PASSWORD=miska -e POSTGRES_USER=miska \
#     -e POSTGRES_DB=miska -p 15432:5432 postgres:16-alpine
#   DATABASE_URL=postgres://miska:miska@localhost:15432/miska
#   DATABASE_SSL=0
# DATABASE_SSL=0

# --- Proveedor de IA (OpenRouter) -------------------------------------------
# openrouter.ai/keys
OPENROUTER_API_KEY=

# Cualquier slug de openrouter.ai/models que soporte herramientas.
# Se puede cambiar desde el panel sin reiniciar.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Con estas dos alcanza. Las siguientes son opcionales y tienen valor por
# defecto en el código (config.ts), así que no hace falta definirlas:
#
#   OPENROUTER_FALLBACK_MODELS  modelos de respaldo si el principal falla o está
#                               saturado; OpenRouter los prueba en orden dentro
#                               de la misma llamada. Separados por coma.
#   OPENROUTER_APP_URL          atribución del tráfico en los rankings de
#   OPENROUTER_APP_TITLE        OpenRouter. No cambian el comportamiento.
#   OPENROUTER_BASE_URL         solo para apuntar a un proxy propio.

# Poné DRY_RUN=1 para probar el pipeline y el panel sin gastar tokens:
# el bot contesta un mensaje fijo en vez de llamar al modelo.
# DRY_RUN=1

# --- Servidor ---------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Orígenes del panel, separados por coma. Con el panel en Vercel esto es
# obligatorio: es otro dominio y sin esto el navegador bloquea las llamadas.
# Cualquier puerto de localhost se permite siempre, para desarrollo.
DASHBOARD_ORIGIN=https://panel-miska.vercel.app

# URL pública del bot. Necesaria para los webhooks (producción).
# En desarrollo con Telegram en modo polling se puede dejar vacía.
# PUBLIC_URL=https://miska-muska-bot.fly.dev

# Dias que se guarda un adjunto que mando un cliente (el comprobante, un audio)
# antes de borrarlo. El mensaje queda siempre; lo que vence es el archivo.
MEDIA_RETENCION_DIAS=90

# Token para entrar al panel y a /api. Si lo dejás vacío la API queda abierta:
# aceptable solo en localhost.
# ADMIN_TOKEN=algo-largo-y-random

# --- Telegram (etapa 1) -----------------------------------------------------
# Se saca hablando con @BotFather en Telegram: /newbot
# Usá un bot DISTINTO para desarrollo: al arrancar en modo polling el adaptador
# borra el webhook del bot, y si compartís el token le cortás producción.
TELEGRAM_BOT_TOKEN=

# polling = desarrollo local (no necesita URL pública)
# webhook = producción (necesita PUBLIC_URL)
TELEGRAM_MODE=polling

# Solo para modo webhook: cadena random que Telegram devuelve en cada request.
# TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (etapa 2) -------------------------------------------
# Todo esto sale de developers.facebook.com > tu app > WhatsApp.
# Mientras estén vacías, el canal queda inactivo y no molesta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lo elegís vos; se pega igual en la config del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=

# App secret de la app de Meta. Valida la firma de cada webhook: sin esto,
# cualquiera puede inventar mensajes entrantes.
WHATSAPP_APP_SECRET=

WHATSAPP_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# El panel (apps/dashboard) usa su propia variable, que se define en Vercel:
#   VITE_API_URL=https://miska-muska-bot.fly.dev
# En desarrollo se deja vacía y el proxy de Vite manda /api al localhost:3001.
# ---------------------------------------------------------------------------

# Avisos al celular (Web Push). Se generan UNA vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Cambiarlas invalida todas las suscripciones: cada dispositivo tiene que
# volver a activar los avisos a mano.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@miskamuska.com.ar
