{
  "name": "@miska/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env src/core/store/seed.ts",
    "demo": "tsx --env-file-if-exists=../../.env src/core/store/demo.ts",
    "db:sql": "tsx scripts/dump-schema.mts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.mts",
    "setup:supabase": "tsx --env-file-if-exists=../../.env scripts/setup-supabase.mts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
